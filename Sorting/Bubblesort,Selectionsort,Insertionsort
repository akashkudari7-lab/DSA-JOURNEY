//BUBBLE SORTING
#include<iostream>
using namespace std;

void bubbleSort(int A[],int n){
    for(int i=0;i<n-1;i++){
        for(int j=0;j<n-i-1;j++){
            if(A[j]>A[j+1]){
                swap(A[j],A[j+1]);
            }
        }
    }
}
void printArray(int A[],int n){
    for(int i=0;i<n;i++){
        cout<<A<<" "<<endl;
    }
}
int main(){
    int n=5;
    int A[]={4,1,5,2,3};

    bubbleSort(A,n);
    printArray(A,n);
    return 0;
}


//SELECTION SORT
#include<iostream>
using namespace std;

void selectionSort(int A[],int n){
    for(int i=0;i<n-1;i++){
        int smallIdx=i;
        for(int j=i+1;j<n;j++){
            if(A[j]<A[smallIdx]){
                smallIdx=j;
            }
        }
        swap(A[i],A[smallIdx]);
    }
}
void printArray(int A[],int n){
    for(int i=0;i<n;i++){
        cout<<A<<" "<<endl;
    }
}
int main(){
    int n=5;
    int A[]={4,1,5,2,3};

    selectionSort(A,n);
    printArray(A,n);
    return 0;
}

//INSERTION SORT
#include<iostream>
using namespace std;
void insertionSort(int A[],int n){
    for(int i=1;i<n;i++){
        int curr=A[i];
        int pre=i-1;
        while(pre>=0 && A[pre]>curr){
            A[pre+1]=A[pre];
            pre--;
        }
        A[pre+1]=curr; 


    }
} 
void printArray(int A[],int n){
    for(int i=0;i<n;i++){
        cout<<A<<" "<<endl;
    }
}
int main(){
    int n=5;
    int A[]={4,1,5,2,3};

    insertionSort(A,n);
    printArray(A,n);
    return 0;
}   