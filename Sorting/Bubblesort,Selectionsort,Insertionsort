Definition of Sorting

Sorting is the process of arranging data in a particular order, usually:

Ascending order: Small → Large
1, 2, 3, 4, 5
Descending order: Large → Small
5, 4, 3, 2, 1


1. Bubble Sort

Bubble Sort repeatedly compares two adjacent elements and swaps them if they are in the wrong order.

Example:
5 3 8 1 → 3 5 1 8 → 3 1 5 8 → 1 3 5 8

//BUBBLE SORTING
#include<iostream>
using namespace std;

void bubbleSort(int A[],int n){
    for(int i=0;i<n-1;i++){
        for(int j=0;j<n-i-1;j++){
            if(A[j]>A[j+1]){
                swap(A[j],A[j+1]);
            }
        }
    }
}
void printArray(int A[],int n){
    for(int i=0;i<n;i++){
        cout<<A[i]<<" "<<endl;
    }
}
int main(){
    int n=5;
    int A[]={4,1,5,2,3};

    bubbleSort(A,n);
    printArray(A,n);
    return 0;
}


2. Selection Sort

Selection Sort repeatedly finds the smallest element from the unsorted part and places it at the beginning.

Example:
5 3 8 1
→ Find 1 → 1 3 8 5
→ Find 3 → 1 3 8 5
→ Find 5 → 1 3 5 8

//SELECTION SORT
#include<iostream>
using namespace std;

void selectionSort(int A[],int n){
    for(int i=0;i<n-1;i++){
        int smallIdx=i;
        for(int j=i+1;j<n;j++){
            if(A[j]<A[smallIdx]){
                smallIdx=j;
            }
        }
        swap(A[i],A[smallIdx]);
    }
}
void printArray(int A[],int n){
    for(int i=0;i<n;i++){
        cout<<A[i]<<" "<<endl;
    }
}
int main(){
    int n=5;
    int A[]={4,1,5,2,3};

    selectionSort(A,n);
    printArray(A,n);
    return 0;
}

Insertion Sort takes one element at a time and inserts it into its correct position in the already sorted part.

Example:
5 3 8 1
→ 3 5 8 1
→ 3 5 8 1
→ 1 3 5

//INSERTION SORT
#include<iostream>
using namespace std;
void insertionSort(int A[],int n){
    for(int i=1;i<n;i++){
        int curr=A[i];
        int pre=i-1;
        while(pre>=0 && A[pre]>curr){
            A[pre+1]=A[pre];
            pre--;
        }
        A[pre+1]=curr; 


    }
} 
void printArray(int A[],int n){
    for(int i=0;i<n;i++){
        cout<<A[i]<<" "<<endl;
    }
}
int main(){
    int n=5;
    int A[]={4,1,5,2,3};

    insertionSort(A,n);
    printArray(A,n);
    return 0;
}   
